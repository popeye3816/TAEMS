# .env.local로 복사해서 값을 채운다. (.env.local은 git에 올라가지 않음)
# 로컬 개발: `npx supabase status`에 나오는 값 / 운영: Supabase 대시보드 > Project Settings > API Keys

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것
SUPABASE_SECRET_KEY=
# 접속정보 암호화 키: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# 알림 (선택). 비워 두면 시스템 내 알림만 동작
APP_URL=https://taems.vercel.app
CRON_SECRET=
RESEND_API_KEY=
MAIL_FROM=TAEMS <noreply@unipoint.co.kr>
KAKAOWORK_BOT_KEY=
SLACK_WEBHOOK_URL=
